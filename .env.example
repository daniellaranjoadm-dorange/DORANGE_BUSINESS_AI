# Configurações do Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Segurança e Banco de Dados
ALLOW_EMPTY_DB=false
COOKIE_SECURE=false

# Inteligência Artificial (opcional para IA de marketing e catálogo)
GEMINI_API_KEY=

# Variáveis Opcionais (possuem padrões automáticos no código):
# DATA_DIR=data (padrão aponta para a pasta /app/applet/data)
# TRUST_PROXY= (opcional, manter ausente até haver proxy reverso configurado)