# Configurações do Servidor
PORT=3000
HOST=127.0.0.1
# Defina NODE_ENV no processo apenas quando necessário; não fixe development aqui.

# Segurança e Banco de Dados
ALLOW_EMPTY_DB=false
COOKIE_SECURE=false

# Inteligência Artificial (opcional para IA de marketing e catálogo)
GEMINI_API_KEY=
# Modelo da sua conta, usado somente ao optar por IA externa.
GEMINI_MODEL=

# Variáveis Opcionais (possuem padrões automáticos no código):
# DATA_DIR=C:/caminho/privado/homologacao
# TRUST_PROXY= (opcional, manter ausente até haver proxy reverso configurado)
