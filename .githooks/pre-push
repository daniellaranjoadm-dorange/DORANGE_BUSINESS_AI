#!/bin/sh
set -eu

remote_name="${1:-}"
remote_url="${2:-}"
branch=$(git symbolic-ref --short HEAD)

origin_url="https://github.com/daniellaranjoadm-dorange/DORANGE_BUSINESS_AI.git"
studio_url="https://github.com/daniellaranjoadm-dorange/DORANGE_BUSINESS_AI_STUDIO.git"

case "$remote_name:$remote_url:$branch" in
  "origin:$origin_url:recovery/business-ai-r533"|"origin:$origin_url:development/r535-local-pwa")
    allowed_destination="refs/heads/$branch"
    ;;
  "studio:$studio_url:development/r535-local-pwa")
    allowed_destination="refs/heads/main"
    ;;
  *)
    echo "Push bloqueado: remote, URL ou branch nao autorizados."
    exit 1
    ;;
esac

count=0

while read local_ref local_sha remote_ref remote_sha; do
  count=$((count + 1))

  if [ "$remote_ref" != "$allowed_destination" ]; then
    echo "Push bloqueado: destino nao autorizado."
    exit 1
  fi

  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "Push bloqueado: exclusao de branch."
    exit 1
  fi

  if [ "$remote_name" = "studio" ]; then
    expected=$(git rev-parse 98ffe36)

    if [ "$local_sha" != "$expected" ]; then
      echo "Push Studio bloqueado: commit diferente da R5.3.6."
      exit 1
    fi

    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
      echo "Push Studio bloqueado: destino nao esta vazio."
      exit 1
    fi
  fi
done

if [ "$count" -ne 1 ]; then
  echo "Push bloqueado: esperado exatamente um destino."
  exit 1
fi

npm run typecheck
npm test
npm run build
npm run check:publish
